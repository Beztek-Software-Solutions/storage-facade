<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <id>Beztek.Facade.Storage</id>
    <version>1.4.1</version>
    <authors>Peter Thomas</authors>
    <owners>Beztek Software Solutions</owners>
    <projectUrl>https://github.com/Beztek-Software-Solutions/storage-facade</projectUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>Storage Facade</description>
    <releaseNotes>S3: abort incomplete multipart uploads on write failure and on DeleteStorageAsync.</releaseNotes>
    <copyright>Copyright 2023, Beztek Software Solutions</copyright>
    <tags>Beztek.Facade;Beztek.Facade.Storage;storage-facade;StorageFacade</tags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <!-- Prefer explicit Core so transitive AWSSDK stays on the patched line (NU190x / GHSA-9cvc-h2w8-phrp). -->
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.7" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="5.0.0" />
    <PackageReference Include="Aliyun.OSS.SDK.NetCore" Version="2.14.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="MimeTypeMapOfficial" Version="1.0.17" />
    <PackageReference Include="SMBLibrary" Version="1.5.8.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Beztek.Facade.Storage.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
